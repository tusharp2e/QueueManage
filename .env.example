# --- Server ---
PORT=3000

# --- Postgres connection (shared DB, table: smart_wallet_transactions) ---
POSTGRES_USER=db_user
POSTGRES_HOST=localhost
DB_NAME=evmservice
DB_PASSWORD=replace-me
DB_PORT=5432

# --- Bundler service ---
BUNDLER_URL=http://localhost:8080
BUNDLER_AUTH_TOKEN=replace-with-shared-secret

# --- Dispatcher ---
DISPATCHER_INTERVAL_MS=5000
MAX_BATCH_SIZE=10

# --- Stale detector ---
STALE_INTERVAL_MS=60000
STALE_TIMEOUT_MINUTES=5

# --- Chain / wallet addresses (consumed by src/config/chainInfo.js) ---
TESTNET_ENTRYPOINT_ADDRESS=0x0000000000000000000000000000000000000000
TESTNET_PAYMASTER_ADDRESS=0x0000000000000000000000000000000000000000
TESTNET_DEFAULT_SMARTWALLET_ADDRESS=0x0000000000000000000000000000000000000000
UNIVERSAL_CONTRACT_DEPLOYER=0x0000000000000000000000000000000000000000
