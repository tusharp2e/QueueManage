{
  "name": "queue-manager",
  "version": "0.1.0",
  "description": "Smart wallet transaction queue manager: accepts transaction requests from KWALA, batches them per wallet, and dispatches to the Bundler service.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node migrations/run.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:batch": "node scripts/sendTestBatch.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "moment-timezone": "^0.6.2",
    "pg": "^8.12.0",
    "winston": "^3.13.1",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2",
    "vitest": "^2.1.9"
  }
}
